  "proposed_component_tests": [
    {
      "id": "NS01",
      "trigger": "Prueba sintética nueva con retry_tick=None y selector heredado",
      "expected_oracle": "Reproducir COMMAND_HEADER_INVALID; preservar I88/I89 y no reconstruir su retorno",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS02",
      "trigger": "NP01 T, prueba remota exacta y contexto REMOTE EXECUTE/CLOSE compatible",
      "expected_oracle": "Retener null observado, digest original y metadata_policy_ref; mismo retorno/una llamada",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS03",
      "trigger": "NP02 R, prueba remota exacta y contexto compatible",
      "expected_oracle": "Mantener schema/familia R y null; no convertir a T ni aceptar alias por nombre",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS04",
      "trigger": "Valores int0/int1023/bool/float/string/int1024",
      "expected_oracle": "Primeros válidos bajo política; tipos/rango restantes rechazados sin coerción",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS05",
      "trigger": "retry_tick ausente, None presente o schema/forma desconocidos",
      "expected_oracle": "Distinguir ausencia/null; no insertar campo ni aprender policy de payload",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS06",
      "trigger": "None en seq/version/ledger_version u otro entero sin excepción",
      "expected_oracle": "Rechazar; NP no vuelve nullable todo el catálogo",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS07",
      "trigger": "Rol CLIENT/Drive, acción/familia/run/store incompatibles o contexto ausente",
      "expected_oracle": "No activar NP01/NP02 sólo por etiqueta; missing/conflicto cerrado",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS08",
      "trigger": "Recibo Store original con cid/request/seq/flags",
      "expected_oracle": "Preservar cabecera y vínculo; metadata nullable no sustituye campos obligatorios",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS09",
      "trigger": "Resultado remoto de hijo CP07/CP13 sin recibo Store",
      "expected_oracle": "Null proyectado sólo con política/contexto; receipt/command_id permanecen ausentes, sin UUID5 inferido",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS10",
      "trigger": "Reader recibe policy_ref forjado, claves extra o contexto cruzado",
      "expected_oracle": "Rechazar incluso con hashes coherentes; conservar grupos/witnesses y reglas de enlaces I88",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS11",
      "trigger": "Error del observer, excepción original, salida parcial, cuotas/restauración",
      "expected_oracle": "Misma llamada/retorno/excepción; latch y primer diagnóstico, cleanup original; una escritura y límites compartidos intactos",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    },
    {
      "id": "NS12",
      "trigger": "Final de componente y transición",
      "expected_oracle": "Como máximo componente validado; I92 funcional, IR03, publicación y aceptación global pendientes de decisiones separadas",
      "status": "NOT_RUN",
      "phase": "PROPOSED_I91_SYNTHETIC_COMPONENT_ONLY"
    }
  ],
