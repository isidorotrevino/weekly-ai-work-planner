  "findings": [
    {
      "id": "F127-01",
      "obligation": "E05",
      "kind": "CONTRACT_BOUNDARY_CLARIFICATION",
      "status": "OPEN_FOR_FUTURE_CONTRACT_REVIEW",
      "source_facts": [
        "RELEASE payload/newline write precedes os.close(release_write).",
        "Worker can read RELEASE and proceed independently; no ordering assertion places OS worker exit after coordinator close.",
        "Coordinator calls wait_worker only after that close; normal successful wait return confirms exit and supplies an ordered observation."
      ],
      "logical_interleaving_not_executed": [
        "Coordinator writes complete RELEASE then is descheduled before close.",
        "Worker reads RELEASE, proceeds and may exit before coordinator resumes.",
        "Coordinator closes release descriptor and calls wait_worker, which observes existing exit."
      ],
      "proposed_markers": {
        "t0": "Coordinator launch entry",
        "tR": "Coordinator RELEASE-close complete",
        "tW": "Coordinator wait_worker returnedTrue: timestamp at return, with normal exit and capture success independently validated later; later validation does not move this marker.",
        "tF": "Coordinator actual launch return after finally"
      },
      "proposed_order": "t0<=tR<=tW<=tF",
      "proposed_intervals": [
        "Tpre=tR-t0",
        "Tworker=tW-tR",
        "Tpost=tF-tW"
      ],
      "note": "Use parent observation/reap time, not unobserved OS exit timestamp; charge worker-exit-to-wait-return scheduling latency explicitly. This is proposed review wording, not a contract/source edit or a runtime observation.",
      "logical_model_executed": false
    },
    {
      "id": "F127-02",
      "obligation": "E03/E04/E05",
      "kind": "COST_AND_RESERVE_ACCOUNTING",
      "status": "OPEN_EVIDENCE",
      "note": "Include worker pre-READY work in Tpre and success-path finally work in Tpost. The30-second unassigned reserve cannot absorb an unbounded phase; exceeding a phase budget requires explicit reviewed allocation/revision, never an implicit resource guarantee."
    }
  ],
