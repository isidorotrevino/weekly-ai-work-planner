# Copy to .env. Literal unquoted values; shell environment takes precedence.
DEV_INSTANCE=local
# Every endpoint binds exclusively to 127.0.0.1. Choose unused ports per instance.
DEV_CONTROL_PLANE_PORT=18443
DEV_EFFECT_RECEIVER_PORT=18444
DEV_WORKER_A_PORT=18445
DEV_WORKER_B_PORT=18446
DEV_VERIFIER_PORT=18447
